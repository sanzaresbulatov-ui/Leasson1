import sounddevice as sd
import numpy as np
import scipy.io.wavfile as wav
import speech_recognition as sr
from googletrans import Translator
duration = 5  # секунды записи
sample_rate = 44100
import random
ball = 0
words_by_level_rus = {
    "easy": ["кот", "собака", "яблоко", "молоко", "солнце"],
    "medium": ["банан", "школа", "друг", "окно", "жёлтый"],
    "hard": ["технология", "университет", "информация", "произношение", "воображение"]
}


words_by_level_en = {
    "easy": ["cat", "dog", "apple", "milk", "sun"],
    "medium": ["banana", "school", "friend", "window", "yellow"],
    "hard": ["technology", "university", "information", "direction", "visualisation"]
}

print("Привет! Это игра поможет тебе улучшить твое произношение на разных языках🌍")
v = input("Выбери на каком языке хочешь учиться, en - английский ,rus - русский")

if v == "en" :
    s = input("Отлично! теперь выбери сложность, easy - легкая😀, medium - средняя🙂, hard - сложная😠")
    a = words_by_level_en
    b = "en-EN"

elif v == "rus":
    s = input("Отлично! теперь выбери сложность, easy - легкая😀, medium - средняя🙂, hard - сложная😠")
    a = words_by_level_rus
    b = "ru-RU"
     
else:
    v = input("Кажеться ты выбрал не то, en - английский ,rus - русский")

print("Отлично за каждый правильный ответ, я буду давать тебе баллы , а за неправильный буду отнимать ,если твои баллы будут равны 0 , ты проиграешь!")

while True:
    vybor = random.choice(a[s])
    print("Произнеси слово 1 раз ",vybor)
    recording = sd.rec(
    int(duration * sample_rate), # длительность записи в сэмплах
    samplerate=sample_rate,      # частота дискретизации
    channels=1,                  # 1 — это моно
    dtype="int16")               # формат аудиоданных
    sd.wait()  # ждём завершения записи

    wav.write("output.wav", sample_rate, recording)
    print("Запись завершена, теперь распознаём...")

    recognizer = sr.Recognizer()
    with sr.AudioFile("output.wav") as source:
            audio = recognizer.record(source)

    try:
        text = recognizer.recognize_google(audio, language=b)

    except sr.UnknownValueError:             # - если Google не понял речь (шум, молчание)
        print("Не удалось распознать речь.")
    except sr.RequestError as e:             # - если нет интернета или API недоступен
        print(f"Ошибка сервиса: {e}")


    if text == vybor:   
            ball += 10
            print("Правильно!✔️ Идем дальше")
    else:
        ball -= 10
        print("Не правильно!❌ Идем дальше")


    if ball <= -50:
         print("Ты проиграл!😓")
         print("0 очков")
         break
    
    
    elif ball == 50:
         print("Ты выиграл!😁")
         print(ball,"очков")
         break
    
         
