@bot.message_handler(commands=['listen'])
def send_listen(message):
    global last_text,b
    duration = b  # секунды записи
    sample_rate = 44100
    bot.reply_to(message, "Говори...")


    recording = sd.rec(
        int(duration * sample_rate), # длительность записи в сэмплах
        samplerate=sample_rate,      # частота дискретизации
        channels=1,                  # 1 — это моно
        dtype="int16")               # формат аудиоданных
    sd.wait()  # ждём завершения записи


    wav.write("output.wav", sample_rate, recording)
    bot.reply_to(message, "Запись завершена, теперь распознаём...")


    recognizer = sr.Recognizer()
    with sr.AudioFile("output.wav") as source:
            audio = recognizer.record(source)


    try:
        text = recognizer.recognize_google(audio, language="ru-RU")
        last_text = text
        bot.reply_to(message, f"Распознано:\n{last_text}")
        bot.reply_to(message, "Отлично теперь пиши команду что хочешь сделать со своим текстом!")

    except sr.UnknownValueError:
        bot.reply_to(message, "Не удалось распознать речь.")
    except sr.RequestError as e:
        bot.reply_to(message, f"Ошибка сервиса: {e}")



@bot.message_handler(commands=['short'])
def send_s(message):
    global last_text, a,b
    if last_text:

        
        sentences = sent_tokenize(last_text, language='russian')

        

        stop_words = set(stopwords.words('russian'))

        words = word_tokenize(last_text)
        words = [word.lower() for word in words if word.isalpha()]
        words = [word for word in words if word not in stop_words]

        morph = pymorphy3.MorphAnalyzer()
        words = [morph.parse(word)[0].normal_form for word in words]

        freq_dist = FreqDist(words)
        sentence_scores = {}

        for i, sentence in enumerate(sentences):
            sentence_words = word_tokenize(sentence.lower())
            morph = pymorphy3.MorphAnalyzer()
            sentence_words = [morph.parse(word)[0].normal_form for word in sentence_words]
            sentence_score = sum([freq_dist[word] for word in sentence_words if word in freq_dist])

            sentence_scores[i] = sentence_score

        sorted_scores = sorted(sentence_scores.items(), key=lambda x: x[1], reverse=True)

        selected_sentences = sorted_scores[:1]
        selected_sentences = sorted(selected_sentences)

        # Формируем суммаризацию
        summary = ' '.join([sentences[i] for i, _ in selected_sentences])

    
     
        bot.reply_to(message, summary)

    else:
        bot.reply_to(message, "Вы еще не записали аудио! для записи /listen")


